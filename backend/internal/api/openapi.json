{
  "openapi": "3.0.3",
  "info": {
    "title": "Palworld Scheduler API",
    "version": "1.0.0",
    "description": "Palworld 伺服器維運 API：排程覆寫（開/關/恢復自動）與完整 RCON。\n\n驗證方式：點右上 **Authorize**，在 `X-Auth-Token` 填入你的 token（對應 config.json 的 api.token）。之後即可對各端點按 **Try it out** 直接調用。\n\n備註：訊息類參數（broadcast/shutdown message）內的空白會被 Palworld 截斷，請用底線 `_` 代替空白。"
  },
  "servers": [
    { "url": "/", "description": "目前主機" }
  ],
  "tags": [
    { "name": "docs", "description": "文件與健康檢查" },
    { "name": "schedule", "description": "排程覆寫控制" },
    { "name": "rcon", "description": "完整 RCON 指令" },
    { "name": "rest-api", "description": "Palworld 官方 REST API（port 8212）代理，回應為結構化 JSON，較 RCON 穩定。需伺服器啟用 RESTAPIEnabled。" },
    { "name": "palsave", "description": "解析存檔取得玩家帕魯資料（經 palsave sidecar）。RCON/REST 都拿不到帕魯資料。" }
  ],
  "components": {
    "securitySchemes": {
      "TokenAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Auth-Token",
        "description": "填入 config.json 的 api.token"
      }
    },
    "schemas": {
      "SaveSource": {
        "type": "object",
        "properties": {
          "root": { "type": "string", "description": "目前的存檔根目錄（絕對路徑）" },
          "exists": { "type": "boolean", "description": "這個資料夾現在是否存在" },
          "current": { "type": "string", "description": "正在讀的 Level.sav（相對 root）" },
          "mtime": { "type": "integer", "description": "該存檔的最後修改時間（Unix 秒）" },
          "worlds": {
            "type": "array",
            "description": "root 底下找得到的世界",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string", "description": "世界資料夾名（那串英數）" },
                "path": { "type": "string", "description": "Level.sav 的相對路徑" },
                "size": { "type": "integer", "description": "Level.sav 大小（bytes）" },
                "mtime": { "type": "integer", "description": "最後修改時間（Unix 秒）" }
              }
            }
          }
        }
      },
      "Status": {
        "type": "object",
        "properties": {
          "mode": { "type": "string", "enum": ["AUTO", "FORCE_ON", "FORCE_OFF"], "description": "目前控制模式" },
          "serverRunning": { "type": "boolean", "description": "Palworld 容器是否執行中" },
          "inOpenWindow": { "type": "boolean", "description": "現在是否在開放時段內" },
          "currentLabel": { "type": "string" },
          "currentCloseAt": { "type": "string" },
          "nextOpenLabel": { "type": "string" },
          "nextOpenAt": { "type": "string" },
          "serverTimeLocal": { "type": "string" }
        }
      },
      "ActionResult": {
        "type": "object",
        "properties": {
          "ok": { "type": "boolean" },
          "action": { "type": "string" }
        }
      },
      "RconResult": {
        "type": "object",
        "properties": {
          "ok": { "type": "boolean" },
          "command": { "type": "string" },
          "response": { "type": "string", "description": "伺服器回應原文" }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "ok": { "type": "boolean", "example": false },
          "error": { "type": "string" }
        }
      },
      "ServerInfo": {
        "type": "object",
        "description": "GET /api/rest/info 回應",
        "properties": {
          "version": { "type": "string", "description": "伺服器版本" },
          "servername": { "type": "string", "description": "伺服器名稱" },
          "description": { "type": "string" },
          "worldguid": { "type": "string", "description": "世界 GUID" }
        }
      },
      "Player": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "accountName": { "type": "string" },
          "playerId": { "type": "string" },
          "userId": { "type": "string", "description": "kick/ban 需用此值" },
          "ip": { "type": "string" },
          "ping": { "type": "number" },
          "location_x": { "type": "number" },
          "location_y": { "type": "number" },
          "level": { "type": "integer" },
          "building_count": { "type": "integer" }
        }
      },
      "PlayerList": {
        "type": "object",
        "properties": {
          "count": { "type": "integer" },
          "players": { "type": "array", "items": { "$ref": "#/components/schemas/Player" } }
        }
      },
      "Metrics": {
        "type": "object",
        "description": "GET /api/rest/metrics 回應",
        "properties": {
          "serverfps": { "type": "integer", "description": "伺服器 FPS" },
          "currentplayernum": { "type": "integer", "description": "目前線上人數" },
          "serverframetime": { "type": "number", "description": "每幀時間 (ms)" },
          "maxplayernum": { "type": "integer", "description": "最大人數" },
          "uptime": { "type": "integer", "description": "運行秒數" },
          "basecampnum": { "type": "integer", "description": "據點數量" },
          "days": { "type": "integer", "description": "遊戲內天數" }
        }
      },
      "RestAction": {
        "type": "object",
        "properties": {
          "ok": { "type": "boolean" },
          "action": { "type": "string" }
        }
      },
      "Pal": {
        "type": "object",
        "properties": {
          "species": { "type": "string", "description": "內部代號" },
          "name_zh": { "type": "string", "description": "中文名（繁體）" },
          "name_en": { "type": "string", "description": "英文名" },
          "nickname": { "type": "string" },
          "paldeck": { "type": "string", "description": "圖鑑編號" },
          "elements": { "type": "array", "items": { "type": "string" }, "description": "屬性（水/火/草/雷/冰/龍/暗/地/無）" },
          "level": { "type": "integer" },
          "exp": { "type": "integer" },
          "gender": { "type": "string" },
          "rank": { "type": "integer", "description": "星級 1-5" },
          "souls": { "type": "object", "description": "靈魂強化等級 {hp, attack, defense, craftspeed}" },
          "iv_hp": { "type": "integer", "description": "HP 個體值 0-100" },
          "iv_attack": { "type": "integer", "description": "攻擊個體值 0-100 (Talent_Shot)" },
          "iv_defense": { "type": "integer", "description": "防禦個體值 0-100" },
          "hp": { "type": "integer", "description": "目前 HP（已除內部 ×1000）" },
          "friendship": { "type": "integer", "description": "好感度點數" },
          "stomach": { "type": "integer", "description": "飽食度" },
          "food_buff": { "type": "string", "description": "食物狀態效果" },
          "work": { "type": "object", "description": "工作適性 {中文適性: 等級}" },
          "is_alpha": { "type": "boolean", "description": "是否為 α/BOSS 變體" },
          "is_lucky": { "type": "boolean", "description": "是否為 Lucky(閃光)" },
          "active_skills": { "type": "array", "items": { "type": "string" }, "description": "已裝備主動技能（繁中）" },
          "mastered_skills": { "type": "array", "items": { "type": "string" }, "description": "已習得主動技能（繁中）" },
          "passives": { "type": "array", "items": { "type": "string" }, "description": "被動技能（繁中）" }
        }
      },
      "PalPlayer": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "uid": { "type": "string", "description": "存檔內玩家 UID" },
          "level": { "type": "integer" },
          "exp": { "type": "integer" },
          "hp": { "type": "integer", "description": "目前 HP（已除內部 ×1000）" },
          "shield_hp": { "type": "integer" },
          "stomach": { "type": "integer", "description": "飽食度" },
          "hunger": { "type": "string", "description": "飢餓狀態" },
          "health": { "type": "string", "description": "健康/受傷狀態" },
          "unused_status_point": { "type": "integer", "description": "未分配能力點" },
          "status_points": { "type": "object", "description": "已配點 {hp, stamina, attack, weight, capture, workspeed}" },
          "voice_id": { "type": "integer" },
          "location": { "type": "object", "description": "最後位置 {x, y, z}" },
          "pal_count": { "type": "integer" },
          "pals": { "type": "array", "items": { "$ref": "#/components/schemas/Pal" } }
        }
      },
      "PalsResult": {
        "type": "object",
        "properties": {
          "total_pals": { "type": "integer" },
          "orphan_pals": { "type": "integer" },
          "source": { "type": "string", "description": "解析的存檔相對路徑" },
          "players": { "type": "array", "items": { "$ref": "#/components/schemas/PalPlayer" } }
        }
      }
    }
  },
  "security": [{ "TokenAuth": [] }],
  "paths": {
    "/api/pals/analyze": {
      "post": {
        "tags": ["palsave"],
        "summary": "解析上傳的存檔（不落地）",
        "description": "把一份 Level.sav 的位元組直接送上來解析，回傳與 /api/pals 相同的結構。\n\n整份存檔只會在記憶體裡走一遍（Go 這層串流轉發、palsave 那層從 bytes 解析），伺服器磁碟上不會留下任何副本，也不會動到這台伺服器自己的存檔或快取。\n\n給單機／自架玩家用：他們沒辦法把面板架起來，但手上就有存檔。上限 512 MB；公開入口（nginx）另外對這條路徑限流 3 次/分。",
        "requestBody": {
          "required": true,
          "content": {
            "application/octet-stream": { "schema": { "type": "string", "format": "binary" } },
            "multipart/form-data": { "schema": { "type": "object", "properties": { "file": { "type": "string", "format": "binary" } } } }
          }
        },
        "responses": {
          "200": { "description": "解析結果（多了 source=\"(上傳的存檔)\" 與 uploaded=true）", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PalsResult" } } } },
          "400": { "description": "不是有效的 Palworld 存檔，或沒有收到內容" },
          "413": { "description": "檔案超過 512 MB" },
          "429": { "description": "上傳太頻繁（由 nginx 限流）" },
          "503": { "description": "存檔解析未啟用（config.json 的 palsave.enabled=false）" }
        }
      }
    },
    "/api/palsave/source": {
      "get": {
        "tags": ["palsave"],
        "summary": "查詢目前的存檔來源",
        "description": "回報現在讀的是哪個資料夾、選中哪個世界，以及這個根目錄底下有哪些世界可選。",
        "responses": {
          "200": { "description": "來源資訊", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SaveSource" } } } },
          "502": { "description": "呼叫 palsave 失敗" },
          "503": { "description": "存檔解析未啟用" }
        }
      },
      "post": {
        "tags": ["palsave"],
        "summary": "改用指定的絕對路徑當存檔根目錄",
        "description": "不必再依賴 backend/palworld-data，可以直接指到伺服器上任一存檔資料夾，之後的定時監控與面板資料都改讀那裡。\n\n⚠️ 這是管理者操作，公開入口（nginx）刻意擋掉這條路徑，只能直接打排程器的 9000 埠並帶 API token。\n\n路徑是在「跑排程器的那台機器」上解析的 —— Docker 版要注意那是容器內的路徑，主機資料夾必須先掛進容器。只接受底下含 Pal/Saved/SaveGames 的資料夾；切換成功會立刻作廢預熱快取並重抓。要永久生效請一併寫進 config.json 的 palsave.saveRoot。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["root"],
                "properties": { "root": { "type": "string", "description": "存檔根目錄的絕對路徑", "example": "/palworld" } }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "已切換", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SaveSource" } } } },
          "400": { "description": "找不到資料夾，或底下沒有 Pal/Saved/SaveGames" },
          "502": { "description": "呼叫 palsave 失敗" },
          "503": { "description": "存檔解析未啟用" }
        }
      }
    },
    "/healthz": {
      "get": {
        "tags": ["docs"],
        "summary": "健康檢查（免 token）",
        "security": [],
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "schema": { "type": "object", "properties": { "ok": { "type": "boolean" } } } } } }
        }
      }
    },
    "/api/status": {
      "get": {
        "tags": ["schedule"],
        "summary": "查詢目前狀態",
        "responses": {
          "200": { "description": "狀態快照", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Status" } } } },
          "401": { "description": "未授權", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/api/start": {
      "post": {
        "tags": ["schedule"],
        "summary": "強制開啟（FORCE_ON）",
        "description": "忽略排程保持開啟，直到呼叫 /api/auto。",
        "responses": {
          "200": { "description": "已切換", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ActionResult" } } } }
        }
      }
    },
    "/api/stop": {
      "post": {
        "tags": ["schedule"],
        "summary": "強制關閉（FORCE_OFF）",
        "description": "執行 onManualStop 流程（倒數→存檔→關閉）。忽略排程保持關閉，直到 /api/auto 或 /api/start。",
        "parameters": [
          { "name": "countdown", "in": "query", "required": false, "schema": { "type": "integer", "default": 15 }, "description": "倒數秒數，覆寫流程中的 countdown 步驟" }
        ],
        "responses": {
          "200": { "description": "已切換", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ActionResult" } } } }
        }
      }
    },
    "/api/auto": {
      "post": {
        "tags": ["schedule"],
        "summary": "恢復自動排程（AUTO）",
        "responses": {
          "200": { "description": "已切換", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ActionResult" } } } }
        }
      }
    },
    "/api/rcon": {
      "post": {
        "tags": ["rcon"],
        "summary": "送出任意 RCON 指令",
        "parameters": [
          { "name": "command", "in": "query", "required": false, "schema": { "type": "string" }, "description": "RCON 指令；也可改用 JSON body" }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": { "type": "object", "properties": { "command": { "type": "string", "example": "Broadcast GLHF" } } }
            }
          }
        },
        "responses": {
          "200": { "description": "RCON 回應", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RconResult" } } } },
          "400": { "description": "缺少 command", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "502": { "description": "RCON 失敗", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/api/broadcast": {
      "post": {
        "tags": ["rcon"],
        "summary": "全服廣播 (Broadcast)",
        "parameters": [
          { "name": "msg", "in": "query", "required": true, "schema": { "type": "string", "example": "Hello_everyone" }, "description": "訊息（空白用底線）" }
        ],
        "responses": {
          "200": { "description": "已送出", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RconResult" } } } },
          "400": { "description": "缺少 msg", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/api/save": {
      "post": {
        "tags": ["rcon"],
        "summary": "存檔 (Save)",
        "responses": {
          "200": { "description": "已送出", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RconResult" } } } }
        }
      }
    },
    "/api/players": {
      "get": {
        "tags": ["rcon"],
        "summary": "在線玩家（改走 REST）",
        "description": "已改用官方 REST 取得結構化玩家資料：RCON 的 ShowPlayers 遇含中文（多位元組）玩家名會因帕魯回應封包長度算錯而讀取逾時，故此端點優先走 REST，回傳與 /api/rest/players 相同。REST 未啟用時才退回 RCON（含中文玩家可能逾時）。",
        "responses": {
          "200": { "description": "玩家列表", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PlayerList" } } } },
          "502": { "description": "REST 呼叫失敗", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/api/info": {
      "get": {
        "tags": ["rcon"],
        "summary": "伺服器資訊 (Info)",
        "responses": {
          "200": { "description": "伺服器版本與名稱", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RconResult" } } } }
        }
      }
    },
    "/api/kick": {
      "post": {
        "tags": ["rcon"],
        "summary": "踢出玩家 (KickPlayer)",
        "parameters": [
          { "name": "steamid", "in": "query", "required": true, "schema": { "type": "string" }, "description": "SteamID（可先呼叫 /api/players 取得）" }
        ],
        "responses": {
          "200": { "description": "已送出", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RconResult" } } } },
          "400": { "description": "缺少 steamid", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/api/ban": {
      "post": {
        "tags": ["rcon"],
        "summary": "封鎖玩家 (BanPlayer)",
        "parameters": [
          { "name": "steamid", "in": "query", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "已送出", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RconResult" } } } },
          "400": { "description": "缺少 steamid", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/api/unban": {
      "post": {
        "tags": ["rcon"],
        "summary": "解除封鎖 (UnBanPlayer)",
        "parameters": [
          { "name": "steamid", "in": "query", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "已送出", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RconResult" } } } },
          "400": { "description": "缺少 steamid", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/api/shutdown": {
      "post": {
        "tags": ["rcon"],
        "summary": "伺服器倒數關閉 (Shutdown)",
        "description": "Palworld 內建：伺服器自行倒數、存檔、關閉。",
        "parameters": [
          { "name": "seconds", "in": "query", "required": false, "schema": { "type": "integer", "default": 60 } },
          { "name": "message", "in": "query", "required": false, "schema": { "type": "string", "example": "Server_shutting_down" }, "description": "訊息（空白用底線）" }
        ],
        "responses": {
          "200": { "description": "已送出", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RconResult" } } } }
        }
      }
    },
    "/api/doexit": {
      "post": {
        "tags": ["rcon"],
        "summary": "立即關閉 (DoExit)",
        "description": "強制停止伺服器，不倒數。",
        "responses": {
          "200": { "description": "已送出", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RconResult" } } } }
        }
      }
    },
    "/api/teleport": {
      "post": {
        "tags": ["rcon"],
        "summary": "傳送 (TeleportToMe / TeleportToPlayer)",
        "description": "需要遊戲內管理員情境；透過 RCON 多半無效，僅作為通道保留。",
        "parameters": [
          { "name": "steamid", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "mode", "in": "query", "required": false, "schema": { "type": "string", "enum": ["tome", "toplayer"], "default": "tome" } }
        ],
        "responses": {
          "200": { "description": "已送出", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RconResult" } } } },
