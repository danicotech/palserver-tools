        "parameters": [
          { "name": "uuid", "in": "query", "required": false, "schema": { "type": "string" }, "description": "以存檔內玩家 UUID（或名稱）部分比對過濾" }
        ],
        "responses": {
          "200": { "description": "玩家清單（players 內每筆為 PalPlayer 去掉 pals 欄位）", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PalsResult" } } } },
          "502": { "description": "呼叫 palsave 失敗", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "503": { "description": "存檔解析未啟用", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
