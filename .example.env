# =============================================================================
#  Palworld Server Suite - environment configuration
#
#  HOW TO USE:
#    1. Copy this file to `.env` in the project root  (the one-click start
#       scripts do this for you automatically on first run).
#    2. Edit any value below, then restart:  double-click restart.bat
#       (Windows) or run ./restart.sh (Linux).  Docker Compose reads `.env`
#       automatically - every variable here overrides the compose defaults.
#    3. `.env` is git-ignored, so your passwords never leave this machine.
#
#  All values are OPTIONAL. Anything you leave out (or delete) falls back to
#  the default shown here. Booleans are the strings "True"/"False" unless
#  noted. Rates are multipliers where 1.0 = the game's normal value.
# =============================================================================

# ---------------------------------------------------------------------------
# Core / identity
# ---------------------------------------------------------------------------
# Timezone for the game server, scheduler and logs (IANA name).
TZ=Asia/Taipei
# File owner uid/gid inside the container. Match the host user that owns
# backend/palworld-data (Linux). Windows/Docker Desktop: leave as-is.
PUID=1000
PGID=1000
# Server name & description shown in the in-game server browser.
SERVER_NAME=My Palworld Server
SERVER_DESCRIPTION=Powered by palserver-tools
# Max concurrent players (1-32 officially; community image allows more).
PLAYERS=32
# Game port (UDP). If you change it, also change the port mapping in
# backend/docker-compose.yml ("8211:8211/udp").
PORT=8211
# Use all CPU cores for the server process.
MULTITHREADING=true
# List the server on the official community server browser (needs PUBLIC_IP).
COMMUNITY=false

# ---------------------------------------------------------------------------
# Passwords / access  (REQUIRED - the setup script fills these randomly)
# ---------------------------------------------------------------------------
# Admin/RCON password. MUST equal `rcon.password` in backend/config.json
# (the setup script keeps them in sync automatically).
ADMIN_PASSWORD=CHANGE_ME_ADMIN
# Password players must enter to join. Empty = no password.
SERVER_PASSWORD=CHANGE_ME_JOIN
# Public IPv4 announced to the server browser. Leave empty for dynamic IP.
PUBLIC_IP=
# Require authenticated Steam accounts. Recommended True for public servers.
USEAUTH=False
# Which platforms may connect: (Steam) | (Steam,Xbox,PS5,Mac) ...
CROSSPLAY_PLATFORMS=(Steam)

# ---------------------------------------------------------------------------
# Difficulty & rates (multipliers, 1.0 = normal)
# ---------------------------------------------------------------------------
# Overall difficulty preset: None | Normal | Difficult | Hard
DIFFICULTY=Hard
# Experience gain multiplier.
EXP_RATE=1.0
# Pal capture rate multiplier (lower = harder to catch).
PAL_CAPTURE_RATE=1.0
# Damage dealt BY pals / damage taken BY pals.
PAL_DAMAGE_RATE_ATTACK=1.0
PAL_DAMAGE_RATE_DEFENSE=1.0
# Damage dealt BY players / damage taken BY players.
PLAYER_DAMAGE_RATE_ATTACK=1.0
PLAYER_DAMAGE_RATE_DEFENSE=1.0
# How fast hunger drops (lower = slower starvation).
PLAYER_STOMACH_DECREASE_RATE=1.0
# How fast stamina drains.
PLAYER_STAMINA_DECREASE_RATE=1.0
# Passive HP regen for players (awake / asleep) and pals in palbox (asleep).
PLAYER_AUTO_HP_REGEN_RATE=1.0
PLAYER_AUTO_HP_REGEN_RATE_IN_SLEEP=1.0
PAL_AUTO_HP_REGEN_RATE_IN_SLEEP=1.0
# Damage buildings take from attacks / natural decay rate (0 = never decays).
BUILD_OBJECT_DAMAGE_RATE=1.0
BUILD_OBJECT_DETERIORATION_DAMAGE_RATE=0.0
# Item weight multiplier (lower = carry more).
ITEM_WEIGHT_RATE=1.0
# Hatching time for the DEFAULT egg, in real hours (e.g. 2.5 = 2h30m; 0 = instant).
PAL_EGG_DEFAULT_HATCHING_TIME=72.0

# ---------------------------------------------------------------------------
# World limits & timers
# ---------------------------------------------------------------------------
# Max dropped items in the world / how long drops stay (hours).
DROP_ITEM_MAX_NUM=3000
DROP_ITEM_ALIVE_MAX_HOURS=1.0
# Max working pals per base camp (high values cost server CPU).
BASE_CAMP_WORKER_MAX_NUM=15
# Max members per guild / max base camps per guild.
GUILD_PLAYER_MAX_NUM=20
BASE_CAMP_MAX_NUM_IN_GUILD=4
# Max players in one co-op session slot.
COOP_PLAYER_MAX_NUM=4
# Minutes between supply-drop events.
SUPPLY_DROP_SPAN=180
# Anti-spam: chat messages allowed per player per minute.
CHAT_POST_LIMIT_PER_MINUTE=10

# ---------------------------------------------------------------------------
# Gameplay toggles ("True"/"False")
# ---------------------------------------------------------------------------
# Friendly fire between players.
ENABLE_PLAYER_TO_PLAYER_DAMAGE=False
# Aim assist for keyboard/mouse players.
ENABLE_AIM_ASSIST_KEYBOARD=True
# Multiplayer mode (keep True for a dedicated server).
IS_MULTIPLAY=True
# PvP mode.
IS_PVP=False
# Let new players pick their spawn point on the map.
IS_START_LOCATION_SELECT_BY_MAP=True
# Other guilds' players can damage your base defenses.
ENABLE_DEFENSE_OTHER_GUILD_PLAYER=True
# Show the player list in-game (ESC menu).
SHOW_PLAYER_LIST=True
# Allow exporting pals through the global palbox.
ALLOW_GLOBAL_PALBOX_EXPORT=False

# ---------------------------------------------------------------------------
# Advanced (rarely changed)
# ---------------------------------------------------------------------------
# RCON (used internally by the scheduler; keep enabled).
RCON_ENABLED=true
RCON_PORT=25575
# Official REST API (used internally for broadcasts/player list; keep enabled).
REST_API_ENABLED=true
REST_API_PORT=8212
