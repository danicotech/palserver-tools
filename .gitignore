# ==== 私人資料/大檔 —— 絕對不要進版控 ====
# 遊戲本體 + 存檔 + 備份(數 GB;含玩家個資)
backend/palworld-data/
# 排程器落地資料(上線統計等)
backend/data/
# 機密環境變數(密碼、token)
.env
# 本機私有 compose 疊加(對外通道等,不公開)
docker-compose.override.yml
*.7z

# ==== 本機設定(從 config.example.json 複製起手)====
backend/config.json

# ==== 建置產物 / 相依 ====
node_modules/
frontend/packages/*/dist/
__pycache__/
*.pyc

# ==== 編輯器/系統 ====
.DS_Store
Thumbs.db

# 內部開發筆記
.claude/

# 本機 Windows 工具二進位(部署走 Docker,不需要)
backend/pal.exe

# launcher build artifacts (users build their own via go build)
palserver.exe
palserver

# SteamCMD 版由 install 腳本編譯出來的排程器執行檔
backend/palscheduler
backend/palscheduler.exe
backend/data/

# SteamCMD 版的伺服器本體與 SteamCMD(數 GB,由 install 腳本自行下載)
# 路徑是 windows/native 與 linux/native —— 舊版寫成 native/windows 是相反的,
# 導致跑過 install.bat 後 steamcmd 整包被 git 追蹤。
windows/native/server/
windows/native/steamcmd/
linux/native/server/
linux/native/steamcmd/

# 離線開發素材：從真實伺服器匯出的玩家/帕魯資料，絕對不可進版控
frontend/packages/web/public/pals_fixture.json

# 高解析地圖圖磚(5461 檔 / 約 108 MB)。不進版控:
# 沒有它會自動退回單張 palworld-full-map.jpg,要啟用就跑 tools/fetch-map-tiles.mjs。
frontend/packages/web/public/map-tiles/

# 互動地圖標記(56 類、14,013 筆,373 KB)。資料來源是 op.gg 整理的成果,
# 不隨專案散布;要用就跑 node tools/fetch-map-points.mjs 自行產生。
frontend/packages/web/public/game-data/map-points.json

# 地圖標記用的 NPC 頭像(10 張,由 fetch-map-points.mjs 一併取得)
frontend/packages/web/public/game-data/map-icons/
frontend/packages/web/public/game-data/pal-spawns.json
# 標記的名稱與掉落表;跑 node tools/fetch-map-detail.mjs 自行產生。
frontend/packages/web/public/game-data/map-detail.json

# 標記詳細面板資料;跑 node tools/fetch-map-panel.mjs 自行產生。
frontend/packages/web/public/game-data/map-panel.json

# 蛋與商店的面板資料;跑 node tools/fetch-egg-shop.mjs 一併產生。
